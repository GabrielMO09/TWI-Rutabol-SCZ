# Detectar archivos de texto
* text=auto

# Docker y configuraciones Linux
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf

# Frontend
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf

# DNS BIND9
dns/** text eol=lf

# Scripts
*.sh text eol=lf
*.ps1 text eol=crlf

# Documentación
*.md text eol=lf